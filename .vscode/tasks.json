{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SpecRail",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run SpecRail Tests",
            "type": "shell",
            "command": "cargo",
            "args": [
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run SpecRail CLI",
            "type": "shell",
            "command": "cargo",
            "args": [
                "run",
                "--bin",
                "specrail"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Optimize and Build SpecRail",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Install SpecRail",
            "type": "shell",
            "command": "cargo",
            "args": [
                "install",
                "--path",
                ".",
                "--force"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run MCP Server",
            "type": "shell",
            "command": "cargo",
            "args": [
                "run",
                "--bin",
                "mcp_server"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Package VSCode Extension",
            "type": "shell",
            "command": "printf 'y\\n' | npx @vscode/vsce package",
            "options": {
                "cwd": "${workspaceFolder}/.vscode/specrail-chat-bridge"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "Install Specrail Chat Bridge",
            "type": "shell",
            "command": "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code",
            "args": [
                "--install-extension",
                "${workspaceFolder}/.vscode/specrail-chat-bridge/specrail-chat-bridge-0.0.1.vsix",
                "--force"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        }
    ]
}